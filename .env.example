# ============================================================
# Verificación de Permisos — configuración
# Copiar a .env y completar los valores marcados.
# ============================================================

APP_NAME=Verificación de Permisos
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# --- Base de datos (Supabase, esquema fda) ------------------
# Dashboard -> Connect -> Direct connection. Completar la contraseña.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.zbaoskblwtnfrownumbv.supabase.co:5432/postgres
DB_SCHEMA=fda

# --- Supabase Auth ------------------------------------------
# La clave publicable es segura de exponer: no autoriza por sí sola.
SUPABASE_URL=https://zbaoskblwtnfrownumbv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_i69xYL4V6e_m-tTCaTSfig_LsjqlWxb

# Clave de servicio, necesaria SOLO para la pantalla de administración de
# usuarios (crear, editar y borrar cuentas). Salta las políticas RLS y da
# acceso total a la base: no debe salir del servidor ni entrar al repositorio.
# Se obtiene en Project Settings -> API Keys. Si se deja vacía, la pantalla
# de usuarios queda deshabilitada y el resto de la aplicación funciona igual.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto con el que Supabase firma los access token. OBLIGATORIO en produccion:
# sin el no se puede comprobar la firma y cualquier token fabricado a mano seria
# aceptado como sesion valida. Panel de Supabase > Settings > API > JWT Secret.
# No hace falta si el proyecto firma con claves asimetricas (ES256/RS256): en ese
# caso la firma se comprueba contra el JWKS que publica SUPABASE_URL.
SUPABASE_JWT_SECRET=

# --- Sesión --------------------------------------------------
# Clave para firmar cookies propias. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR_ANTES_DE_PRODUCCION

# En desarrollo local sobre http hay que desactivarlo, o el navegador
# descarta las cookies de sesión.
COOKIE_SECURE=false

# --- OpenAI --------------------------------------------------
# A diferencia de la versión React, la clave vive solo en el servidor.
# El navegador nunca la recibe.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Límites -------------------------------------------------
MAX_UPLOAD_MB=100
